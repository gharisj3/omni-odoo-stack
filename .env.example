# Purpose: Example environment file for omni-odoo-stack local and OCI deployments.

# Compose project naming
COMPOSE_PROJECT_NAME=omni-odoo-stack

# PostgreSQL settings
POSTGRES_DB=odoo
POSTGRES_USER=odoo
POSTGRES_PASSWORD=replace_with_strong_database_password

# Odoo settings
ODOO_ADMIN_PASSWD=replace_with_strong_odoo_master_password
ODOO_DB_HOST=db
ODOO_DB_PORT=5432
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=replace_with_strong_database_password
ODOO_DB_NAME=odoo
ODOO_PROXY_MODE=True
ODOO_HTTP_PORT=8069
ODOO_LONGPOLLING_PORT=8072
ODOO_LOG_LEVEL=info
ODOO_WORKERS=2
ODOO_LIST_DB=False

# Internal service URLs used by Odoo and n8n
OMNI_ODOO_BASE_URL=http://odoo:8069
OMNI_AI_BASE_URL=http://ai-middleware:8000
OMNI_PUBLIC_BASE_URL=http://localhost
OMNI_API_KEY=replace_with_shared_odoo_api_key

# FastAPI middleware settings
AI_SHARED_API_KEY=replace_with_shared_fastapi_key
AI_MOCK_MODE=true
AI_LOG_LEVEL=INFO
AI_REQUEST_TIMEOUT_SECONDS=30
AI_CORS_ORIGINS=*
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# n8n settings
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=replace_with_n8n_password
N8N_ENCRYPTION_KEY=replace_with_long_n8n_encryption_key
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PORT=5678
N8N_PATH=/n8n/
N8N_EDITOR_BASE_URL=http://localhost/n8n/
N8N_WEBHOOK_URL=http://localhost/n8n/
N8N_LOG_LEVEL=info
N8N_RUNNERS_ENABLED=true

# WhatsApp Cloud API settings
META_GRAPH_API_BASE_URL=https://graph.facebook.com/v20.0
META_VERIFY_TOKEN=replace_with_meta_webhook_verify_token
META_WHATSAPP_TOKEN=your_meta_token_here
META_PHONE_NUMBER_ID=your_phone_number_id_here

# Nginx and public host settings
NGINX_HOST=localhost
NGINX_SERVER_NAME=localhost
NGINX_ENABLE_TLS=false
LETSENCRYPT_EMAIL=ops@example.com


<?xml version="1.0" encoding="utf-8"?>
<!-- Purpose: Dashboard, list, and form views for omni_automation observability. -->
<odoo>
    <record id="view_omni_automation_log_tree" model="ir.ui.view">
        <field name="name">omni.automation.log.tree</field>
        <field name="model">omni.automation.log</field>
        <field name="arch" type="xml">
            <tree decoration-success="status == 'success'" decoration-danger="status == 'failed'">
                <field name="created_at"/>
                <field name="trigger"/>
                <field name="action"/>
                <field name="status"/>
                <field name="lead_id"/>
                <field name="message_id"/>
            </tree>
        </field>
    </record>

    <record id="view_omni_automation_log_form" model="ir.ui.view">
        <field name="name">omni.automation.log.form</field>
        <field name="model">omni.automation.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="trigger"/>
                        <field name="action"/>
                        <field name="status"/>
                        <field name="lead_id"/>
                        <field name="message_id"/>
                        <field name="created_at" readonly="1"/>
                    </group>
                    <group>
                        <field name="payload" widget="text"/>
                        <field name="error_message" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_omni_automation_log_graph" model="ir.ui.view">
        <field name="name">omni.automation.log.graph</field>
        <field name="model">omni.automation.log</field>
        <field name="arch" type="xml">
            <graph string="Automation Status Dashboard" type="bar">
                <field name="status" type="row"/>
                <field name="id" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_omni_automation_logs" model="ir.actions.act_window">
        <field name="name">Automation</field>
        <field name="res_model">omni.automation.log</field>
        <field name="view_mode">graph,tree,form</field>
    </record>

    <menuitem id="menu_omni_automation_root" name="Automation" sequence="10"/>
    <menuitem id="menu_omni_automation_logs" name="Automation Logs" parent="menu_omni_automation_root" action="action_omni_automation_logs" sequence="10"/>
</odoo>


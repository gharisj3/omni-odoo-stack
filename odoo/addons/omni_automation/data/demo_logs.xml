<?xml version="1.0" encoding="utf-8"?>
<!-- Purpose: Demo automation log entries for dashboard and troubleshooting views. -->
<odoo noupdate="1">
    <record id="omni_automation_log_demo_1" model="omni.automation.log">
        <field name="trigger">whatsapp_webhook</field>
        <field name="action">crm_to_ai_pipeline</field>
        <field name="status">success</field>
        <field name="payload">{"phone": "+923001111111", "message": "Need Odoo rollout proposal."}</field>
        <field name="lead_id" ref="omni_crm.omni_crm_lead_1"/>
        <field name="message_id" ref="omni_whatsapp.omni_whatsapp_message_demo_1"/>
    </record>
    <record id="omni_automation_log_demo_2" model="omni.automation.log">
        <field name="trigger">invoice_processor</field>
        <field name="action">vendor_bill_creation</field>
        <field name="status">failed</field>
        <field name="payload">{"invoice": "Vendor bill payload pending approval."}</field>
        <field name="error_message">Vendor account mapping was missing.</field>
    </record>
</odoo>

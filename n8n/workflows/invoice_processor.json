{
  "name": "Invoice Processor Pipeline",
  "nodes": [
    {
      "parameters": {
        "width": 470,
        "height": 200,
        "content": "## Invoice Processor Flow\nThis workflow accepts invoice text, sends it to the FastAPI extractor, validates the result, creates a draft vendor bill in Odoo, and notifies the sender on WhatsApp.\n\nDesigned for demo-safe operation with AI mock mode enabled when no Groq key is available."
      },
      "id": "Invoice_Note",
      "name": "Workflow Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        80,
        20
      ]
    },
    {
      "parameters": {
        "path": "invoice-processor",
        "httpMethod": "POST",
        "responseMode": "responseNode"
      },
      "id": "Invoice_Webhook",
      "name": "Invoice Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        180,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nreturn [{ json: { raw_text: body.invoice_text ?? body.message ?? '' } }];"
      },
      "id": "Extract_Invoice_Text",
      "name": "Extract Invoice Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        260
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.OMNI_AI_BASE_URL}}/extract/invoice",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.AI_SHARED_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{$json}}"
      },
      "id": "Extract_Invoice_Data",
      "name": "Extract Invoice Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        260
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "valid-vendor",
              "leftValue": "={{$json.vendor}}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            },
            {
              "id": "valid-amount",
              "leftValue": "={{$json.amount}}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "Validate_Data",
      "name": "Validate Data",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        900,
        260
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.OMNI_ODOO_BASE_URL}}/api/omni/vendor-bill",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Omni-API-Key",
              "value": "={{$env.OMNI_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{$json}}"
      },
      "id": "Create_Vendor_Bill",
      "name": "Create Vendor Bill",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1140,
        180
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.META_GRAPH_API_BASE_URL}}/{{$env.META_PHONE_NUMBER_ID}}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.META_WHATSAPP_TOKEN}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"messaging_product\":\"whatsapp\",\"to\": $item(0).$node[\"Invoice Webhook\"].json.body?.phone ?? '',\"type\":\"text\",\"text\":{\"body\": \"Vendor bill intake received for \" + $item(0).$node[\"Extract Invoice Data\"].json.vendor + \".\"}}"
      },
      "id": "Send_Bill_Confirmation",
      "name": "Send Bill Confirmation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1380,
        180
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.OMNI_ODOO_BASE_URL}}/api/omni/automation/log",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Omni-API-Key",
              "value": "={{$env.OMNI_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"trigger\":\"invoice_processor\",\"action\":\"validation_failed\",\"status\":\"failed\",\"payload\": $item(0).$node[\"Extract Invoice Data\"].json,\"error_message\":\"Invoice data validation failed in n8n.\"}"
      },
      "id": "Log_Validation_Error",
      "name": "Log Validation Error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1140,
        360
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"status\":\"processed\"}"
      },
      "id": "Invoice_Response",
      "name": "Invoice Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.3,
      "position": [
        1620,
        260
      ]
    }
  ],
  "connections": {
    "Invoice Webhook": {
      "main": [
        [
          {
            "node": "Extract Invoice Text",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Invoice Text": {
      "main": [
        [
          {
            "node": "Extract Invoice Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Invoice Data": {
      "main": [
        [
          {
            "node": "Validate Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Data": {
      "main": [
        [
          {
            "node": "Create Vendor Bill",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Validation Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Vendor Bill": {
      "main": [
        [
          {
            "node": "Send Bill Confirmation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Bill Confirmation": {
      "main": [
        [
          {
            "node": "Invoice Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Validation Error": {
      "main": [
        [
          {
            "node": "Invoice Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "active": false,
  "versionId": "3f1afeba-05d3-4ef9-bfd4-f2cb7313a5ca",
  "meta": {},
  "id": "omni-invoice-processor",
  "tags": []
}

    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst message = body.entry?.[0]?.changes?.[0]?.value?.messages?.[0] ?? {};\nconst contact = body.entry?.[0]?.changes?.[0]?.value?.contacts?.[0] ?? {};\nreturn [{ json: {\n  phone: message.from ?? '',\n  message: message.text?.body ?? '',\n  name: contact.profile?.name ?? 'WhatsApp Lead'\n}}];"
      },
      "id": "Extract_Message",
      "name": "Extract Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        280
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://odoo:8069/api/omni/lead",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Omni-API-Key",
              "value": "={{$env.OMNI_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"name\": $json.name, \"phone\": $json.phone, \"description\": $json.message}"
      },
      "id": "Check_Or_Create_Lead",
      "name": "Check Or Create Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        690,
        280
      ],
      "continueOnFail": true
    },
    {

        "method": "POST",
        "url": "http://ai-middleware:8000/generate/message",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.AI_SHARED_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"context\": $item(0).$node[\"Extract Message\"].json.message, \"customer_name\": $item(0).$node[\"Extract Message\"].json.name, \"intent\": \"lead_capture_confirmation\"}"
      },
      "id": "AI_Analyze_Message",
      "name": "AI Analyze Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        930,
        280
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{$env.META_PHONE_NUMBER_ID}}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.META_WHATSAPP_TOKEN}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"messaging_product\":\"whatsapp\",\"to\": $item(0).$node[\"Extract Message\"].json.phone,\"type\":\"text\",\"text\":{\"body\": $json.message || 'Thanks, your request is now in our CRM and a consultant will follow up shortly.'}}"
      },
      "id": "Send_Confirmation",
      "name": "Send Confirmation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
